{"en":[{"partOfSpeech":"Adjective","language":"English","definitions":[{"definition":"<span class=\"usage-label-sense\" about=\"#mwt18\" typeof=\"mw:Transclusion\"></span> <span class=\"form-of-definition use-with-mention\" about=\"#mwt19\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#comparative\" title=\"Appendix:Glossary\">comparative</a> form of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=\"en\"><a rel=\"mw:WikiLink\" href=\"/wiki/bad#English\" title=\"bad\">bad</a></i></span></span><link rel=\"mw:PageProp/Category\" href=\"./Category:English_comparative_adjectives#WORSE\" about=\"#mwt19\"><span about=\"#mwt19\">: more </span><span class=\"Latn\" lang=\"en\" about=\"#mwt19\"><a rel=\"mw:WikiLink\" href=\"/wiki/bad#English\" title=\"bad\">bad</a></span>","parsedExamples":[{"example":"Your exam results are <b>worse</b> than before."}],"examples":["Your exam results are <b>worse</b> than before."]}]},{"partOfSpeech":"Adverb","language":"English","definitions":[{"definition":"<span class=\"form-of-definition use-with-mention\" about=\"#mwt112\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#comparative\" title=\"Appendix:Glossary\">comparative</a> form of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=\"en\"><a rel=\"mw:WikiLink\" href=\"/wiki/badly#English\" title=\"badly\">badly</a></i> <span class=\"mention-gloss-paren annotation-paren\">(</span><span class=\"ann-pos\">adverb</span><span class=\"mention-gloss-paren annotation-paren\">)</span></span></span><link rel=\"mw:PageProp/Category\" href=\"./Category:English_comparative_adverbs#WORSE\" about=\"#mwt112\"><span about=\"#mwt112\">: more </span><span class=\"Latn\" lang=\"en\" about=\"#mwt112\"><a rel=\"mw:WikiLink\" href=\"/wiki/badly#English\" title=\"badly\">badly</a></span>","parsedExamples":[{"example":"The harder you try, the <b>worse</b> you do."}],"examples":["The harder you try, the <b>worse</b> you do."]},{"definition":"Less <a rel=\"mw:WikiLink\" href=\"/wiki/skillfully\" title=\"skillfully\">skillfully</a>.","parsedExamples":[{"example":"He drives <b>worse</b> than anyone else I know."}],"examples":["He drives <b>worse</b> than anyone else I know."]},{"definition":"More <a rel=\"mw:WikiLink\" href=\"/wiki/severely\" title=\"severely\">severely</a> or <a rel=\"mw:WikiLink\" href=\"/wiki/seriously\" title=\"seriously\">seriously</a>.","parsedExamples":[{"example":"The bad news affected me <b>worse</b> than it did my brother."}],"examples":["The bad news affected me <b>worse</b> than it did my brother."]},{"definition":"Used to start a sentence describing something that is worse.","parsedExamples":[{"example":"Her leg is infected. Still <b>worse</b>, she's developing a fever."}],"examples":["Her leg is infected. Still <b>worse</b>, she's developing a fever."]}]},{"partOfSpeech":"Noun","language":"English","definitions":[{"definition":"<span class=\"usage-label-sense\" about=\"#mwt159\" typeof=\"mw:Transclusion\"></span> Loss; disadvantage; defeat"},{"definition":"That which is worse; something less good.","parsedExamples":[{"example":"Do not think the <b>worse</b> of him for his enterprise."}],"examples":["Do not think the <b>worse</b> of him for his enterprise."]}]},{"partOfSpeech":"Verb","language":"English","definitions":[{"definition":"<span class=\"usage-label-sense\" about=\"#mwt165\" typeof=\"mw:Transclusion\"></span> To make worse; to put at <a rel=\"mw:WikiLink\" href=\"/wiki/disadvantage\" title=\"disadvantage\">disadvantage</a>; to <a rel=\"mw:WikiLink\" href=\"/wiki/discomfit\" title=\"discomfit\">discomfit</a>."}]}],"af":[{"partOfSpeech":"Noun","language":"Afrikaans","definitions":[{"definition":"<span class=\"form-of-definition use-with-mention\" about=\"#mwt171\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#plural_number\" title=\"Appendix:Glossary\">plural</a> of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=\"af\"><a rel=\"mw:WikiLink\" href=\"/wiki/wors#Afrikaans\" title=\"wors\">wors</a></i></span></span>"}]}],"zh":[{"partOfSpeech":"Adjective","language":"Chinese","definitions":[{"definition":"<span class=\"usage-label-sense\" about=\"#mwt178\" typeof=\"mw:Transclusion\"></span> <a rel=\"mw:WikiLink\" href=\"/wiki/bad\" title=\"bad\">bad</a>; <a rel=\"mw:WikiLink\" href=\"/wiki/terrible\" title=\"terrible\">terrible</a>","parsedExamples":[{"translation":"<span lang=\"zh-Latn\" style=\"color:var(--wikt-palette-darkgrey, #54595d)\"><i>zau syun hai jat go hou <b>woes</b> ge cing fong, keoi dou gaau dak dim.</i></span> <span style=\"color:var(--wikt-palette-forestgreen, #235923); font-size:80%;\"><span typeof=\"mw:Entity\">[</span>Jyutping<span typeof=\"mw:Entity\">]</span></span>","example":"<link rel=\"mw:PageProp/Category\" href=\"./Category:Cantonese_terms_with_usage_examples\" about=\"#mwt179\">"}],"examples":["<link rel=\"mw:PageProp/Category\" href=\"./Category:Cantonese_terms_with_usage_examples\" about=\"#mwt179\">"]}]}],"other":[{"partOfSpeech":"Adjective","language":"Middle English","definitions":[{"definition":"<span class=\"form-of-definition use-with-mention\" about=\"#mwt202\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#comparative\" title=\"Appendix:Glossary\">comparative degree</a> of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=\"enm\"><a rel=\"mw:WikiLink\" href=\"/wiki/yvel#Middle_English\" title=\"yvel\">yvel</a></i></span></span><link rel=\"mw:PageProp/Category\" href=\"./Category:Middle_English_comparative_adjectives#WORSE\" about=\"#mwt202\">"},{"definition":"<span class=\"form-of-definition use-with-mention\" about=\"#mwt203\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#comparative\" title=\"Appendix:Glossary\">comparative degree</a> of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=