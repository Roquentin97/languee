ence\" title=\"conference\">conference</a> <span class=\"mention-gloss-paren\" about=\"#mwt590\" typeof=\"mw:Transclusion\">(</span><span class=\"mention-gloss\" about=\"#mwt590\">a formal event where scientists present their research results in speeches, workshops, posters or by other means</span><span class=\"mention-gloss-paren\" about=\"#mwt590\">)</span>"},{"definition":"<span class=\"Latn\" lang=\"en\" about=\"#mwt592\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/meeting#English\" class=\"mw-selflink-fragment\">meeting</a></span>, <a rel=\"mw:WikiLink\" href=\"/wiki/gathering\" title=\"gathering\">gathering</a> <span class=\"mention-gloss-paren\" about=\"#mwt593\" typeof=\"mw:Transclusion\">(</span><span class=\"mention-gloss\" about=\"#mwt593\">a gathering of persons for a purpose<span typeof=\"mw:Entity\">;</span> an assembly</span><span class=\"mention-gloss-paren\" about=\"#mwt593\">)</span>"},{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/meet\" title=\"meet\">meet</a> <span class=\"mention-gloss-paren\" about=\"#mwt595\" typeof=\"mw:Transclusion\">(</span><span class=\"mention-gloss\" about=\"#mwt595\">a sports competition, especially for track and field or swimming</span><span class=\"mention-gloss-paren\" about=\"#mwt595\">)</span>"}]}],"es":[{"partOfSpeech":"Noun","language":"Spanish","definitions":[{"definition":"<span class=\"Latn\" lang=\"en\" about=\"#mwt603\" typeof=\"mw:Transclusion\"><a rel=\"mw:WikiLink\" href=\"/wiki/meeting#English\" class=\"mw-selflink-fragment\">meeting</a></span>"}]}]}