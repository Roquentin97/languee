{"en":[{"partOfSpeech":"Adjective","language":"English","definitions":[{"definition":"Very <a rel=\"mw:WikiLink\" href=\"/wiki/tired\" title=\"tired\">tired</a>; <a rel=\"mw:WikiLink\" href=\"/wiki/zonked\" title=\"zonked\">zonked</a> (out).","parsedExamples":[{"example":"The <b>exhausted</b> man fell asleep immediately."}],"examples":["The <b>exhausted</b> man fell asleep immediately."]},{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/depleted\" title=\"depleted\">Depleted</a> of <a rel=\"mw:WikiLink\" href=\"/wiki/resource\" title=\"resource\">resources</a>.","parsedExamples":[{"example":"The <b>exhausted</b> mine was worthless once all the ore had been extracted."}],"examples":["The <b>exhausted</b> mine was worthless once all the ore had been extracted."]},{"definition":"<span class=\"usage-label-sense\" about=\"#mwt13\" typeof=\"mw:Transclusion\"></span> <a rel=\"mw:WikiLink\" href=\"/wiki/empty\" title=\"empty\">Emptied</a> of <a rel=\"mw:WikiLink\" href=\"/wiki/content\" title=\"content\">contents</a>, especially of <a rel=\"mw:WikiLink\" href=\"/wiki/air\" title=\"air\">air</a>; that has been made into a <a rel=\"mw:WikiLink\" href=\"/wiki/vacuum\" title=\"vacuum\">vacuum</a>."}]},{"partOfSpeech":"Verb","language":"English","definitions":[{"definition":"<span class=\"form-of-definition use-with-mention\" about=\"#mwt163\" typeof=\"mw:Transclusion\"><span class=\"inflection-of-conjoined\">simple <a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#past_tense\" title=\"Appendix:Glossary\">past</a></span> and <a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#past_tense\" title=\"Appendix:Glossary\">past</a> <a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#participle\" title=\"Appendix:Glossary\">participle</a> of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=\"en\"><a rel=\"mw:WikiLink\" href=\"/wiki/exhaust#English\" title=\"exhaust\">exhaust</a></i></span></span>\n\n<span class=\"mw-empty-elt\" about=\"#mwt164\" typeof=\"