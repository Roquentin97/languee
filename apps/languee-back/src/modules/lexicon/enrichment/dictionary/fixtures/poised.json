{"en":[{"partOfSpeech":"Adjective","language":"English","definitions":[{"definition":"Possessing <a rel=\"mw:WikiLink\" href=\"/wiki/poise\" title=\"poise\">poise</a>, having <a rel=\"mw:WikiLink\" href=\"/wiki/self-confidence\" title=\"self-confidence\">self-confidence</a>."},{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/ready\" title=\"ready\">Ready</a>, <a rel=\"mw:WikiLink\" href=\"/wiki/prepared\" title=\"prepared\">prepared</a>.","parsedExamples":[{"example":"He stood there, <b>poised</b> to act, and then suddenly he drew his gun in a smooth arc."}],"examples":["He stood there, <b>poised</b> to act, and then suddenly he drew his gun in a smooth arc."]},{"definition":"<a rel=\"mw:WikiLink\" href=\"/wiki/balanced\" title=\"balanced\">Balanced</a>, in <a rel=\"mw:WikiLink\" href=\"/wiki/position\" title=\"position\">position</a>, in <a rel=\"mw:WikiLink\" href=\"/wiki/equilibrium\" title=\"equilibrium\">equilibrium</a>."}]},{"partOfSpeech":"Verb","language":"English","definitions":[{"definition":"<span class=\"form-of-definition use-with-mention\" about=\"#mwt68\" typeof=\"mw:Transclusion\"><span class=\"inflection-of-conjoined\">simple <a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#past_tense\" title=\"Appendix:Glossary\">past</a></span> and <a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#past_tense\" title=\"Appendix:Glossary\">past</a> <a rel=\"mw:WikiLink\" href=\"/wiki/Appendix:Glossary#participle\" title=\"Appendix:Glossary\">participle</a> of <span class=\"form-of-definition-link\"><i class=\"Latn mention\" lang=\"en\"><a rel=\"mw:WikiLink\" href=\"/wiki/poise#English\" title=\"poise\">poise</a></i></span></span>"}]}]}