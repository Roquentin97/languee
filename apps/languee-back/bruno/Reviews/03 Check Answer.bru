meta {
  name: Check Answer
  type: http
  seq: 3
  tags: [
    reviews
  ]
}

post {
  url: {{base_url}}/api/v1/reviews/{{card_id}}/answer
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

vars:pre-request {
  card_id: 1db3f769-e154-44c6-9b98-87de1037a395
}

body:json {
  {
    "typedAnswer": "come across"
  }
}

tests {
  test("checks the answer or reports an unknown card", function() {
    expect(res.status).to.be.oneOf([200, 400, 404]);
  });

  test("returns the answer result shape without revealing the expected answer", function() {
    if (res.status === 200) {
      expect(res.body.result).to.be.oneOf([
        "correct",
        "close_synonym",
        "incorrect"
      ]);
      expect(res.body).to.have.property("matchedForm");
      expect(res.body).to.have.property("hint");
    }
  });
}
