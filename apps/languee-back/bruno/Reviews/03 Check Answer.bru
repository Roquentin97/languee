meta {
  name: Check Answer
  type: http
  seq: 3
  tags: [
    reviews
  ]
}

post {
  url: {{base_url}}/api/v1/reviews/{{card_id}}/answer
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

vars:pre-request {
  card_id: 1db3f769-e154-44c6-9b98-87de1037a395
}

body:json {
  {
    "typedAnswer": "come across"
  }
}

docs {
  `cloze` cards only. For `inflection` cards use
  POST /reviews/:cardId/check-forms instead - this returns 400 if the card
  is not a `cloze` card.
}

tests {
  test("checks the answer, or reports an unknown/wrong-type card", function() {
    expect(res.status).to.be.oneOf([200, 400, 404]);
  });

  test("returns the answer result shape, revealing word details only on a correct answer", function() {
    if (res.status === 200) {
      expect(res.body.result).to.be.oneOf([
        "correct",
        "incorrect"
      ]);
      expect(res.body).to.have.property("matchedForm");
      expect(res.body).to.have.property("revealed");
      if (res.body.result === "correct") {
        expect(res.body.revealed).to.have.property("lemma");
        expect(res.body.revealed).to.have.property("ipa");
        expect(res.body.revealed).to.have.property("inflectionForms");
      } else {
        expect(res.body.revealed).to.equal(null);
      }
    }
  });
}
