meta {
  name: Get Queue
  type: http
  seq: 2
  tags: [
    reviews
  ]
}

get {
  url: {{base_url}}/api/v1/reviews/queue
  body: none
  auth: inherit
}

params:query {
  limit: 20
  ~deckId: 1db3f769-e154-44c6-9b98-87de1037a395
}

tests {
  test("returns a queue of items or reports an invalid deck", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("each item carries a type and only the matching payload", function() {
    if (res.status === 200) {
      expect(res.body.items).to.be.an("array");
      for (const item of res.body.items) {
        expect(item.cardId).to.be.a("string");
        expect(item.type).to.be.oneOf(["existing", "inflection", "definition"]);
        expect(item.decks).to.be.an("array");
        expect(item.isNew).to.be.a("boolean");

        if (item.type === "existing") {
          expect(item.existing).to.be.an("object");
          expect(item.existing.partOfSpeech).to.be.a("string");
          expect(item.existing.kind).to.be.oneOf([
            "word",
            "phrasal_verb",
            "expression"
          ]);
          expect(item.existing.lemmaLength).to.be.a("number");
          expect(item.inflection).to.equal(null);
          expect(item.definition).to.equal(null);
        }

        if (item.type === "inflection") {
          expect(item.inflection).to.be.an("object");
          expect(item.inflection.lemma).to.be.a("string");
          expect(item.inflection.formKeys).to.be.an("array");
          expect(item.existing).to.equal(null);
          expect(item.definition).to.equal(null);
        }

        if (item.type === "definition") {
          expect(item.definition).to.be.an("object");
          expect(item.definition.lemma).to.be.a("string");
          expect(item.definition).to.have.property("hint1");
          expect(item.definition).to.have.property("hint2");
          expect(item.existing).to.equal(null);
          expect(item.inflection).to.equal(null);
        }
      }
    }
  });
}
