meta {
  name: Get Queue
  type: http
  seq: 2
  tags: [
    reviews
  ]
}

get {
  url: {{base_url}}/api/v1/reviews/queue
  body: none
  auth: inherit
}

params:query {
  limit: 20
  ~deckId: 1db3f769-e154-44c6-9b98-87de1037a395
}

tests {
  test("returns a queue of items or reports an invalid deck", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("each item has a masked prompt shape", function() {
    if (res.status === 200) {
      expect(res.body.items).to.be.an("array");
      for (const item of res.body.items) {
        expect(item.cardId).to.be.a("string");
        expect(item.deckId).to.be.a("string");
        expect(item.deckName).to.be.a("string");
        expect(item.isNew).to.be.a("boolean");
        expect(item.prompt).to.be.an("object");
        expect(item.prompt.definition).to.be.a("string");
        expect(item.prompt.partOfSpeech).to.be.a("string");
        expect(item.prompt.kind).to.be.oneOf([
          "word",
          "phrasal_verb",
          "expression"
        ]);
        expect(item.prompt.lemmaLength).to.be.a("number");
      }
    }
  });
}
