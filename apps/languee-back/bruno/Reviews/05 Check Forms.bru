meta {
  name: Check Forms
  type: http
  seq: 5
  tags: [
    reviews
  ]
}

post {
  url: {{base_url}}/api/v1/reviews/{{card_id}}/check-forms
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

vars:pre-request {
  card_id: 1db3f769-e154-44c6-9b98-87de1037a395
}

body:json {
  {
    "typedForms": {
      "base": "run",
      "past": "ran",
      "present3sg": "runs"
    }
  }
}

docs {
  Feedback only for `inflection` cards - never mutates review state. Grading
  an inflection card is always a self-assessed rating via
  POST /reviews/:cardId/grade.
}

tests {
  test("checks the forms, or reports an unknown/wrong-type card", function() {
    expect(res.status).to.be.oneOf([200, 400, 404]);
  });

  test("returns per-form feedback plus the revealed word", function() {
    if (res.status === 200) {
      expect(res.body.results).to.be.an("object");
      expect(res.body.allCorrect).to.be.a("boolean");
      expect(res.body.revealed).to.be.an("object");
      expect(res.body.revealed.lemma).to.be.a("string");
      for (const key of Object.keys(res.body.results)) {
        const entry = res.body.results[key];
        expect(entry.typed).to.be.a("string");
        expect(entry.expected).to.be.a("string");
        expect(entry.correct).to.be.a("boolean");
      }
    }
  });
}
