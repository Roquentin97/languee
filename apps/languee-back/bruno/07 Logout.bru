meta {
  name: Logout
  type: http
  seq: 7
  tags: [
    auth
  ]
}

post {
  url: {{base_url}}/auth/logout
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("revokes the current session", function() {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("Logged out");
  });
}
