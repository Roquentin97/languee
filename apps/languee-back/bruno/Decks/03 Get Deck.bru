meta {
  name: Get Deck
  type: http
  seq: 3
  tags: [
    decks
  ]
}

get {
  url: {{base_url}}/decks/{{deck_id}}
  body: none
  auth: inherit
}

tests {
  test("returns deck", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("returns deck shape on success", function() {
    if (res.status === 200) {
      expect(res.body.id).to.be.a("string");
      expect(res.body.name).to.be.a("string");
      expect(res.body.language).to.be.a("string");
    }
  });
}
