meta {
  name: Logout All
  type: http
  seq: 8
  tags: [
    auth
  ]
}

post {
  url: {{base_url}}/auth/logout-all
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("revokes all sessions", function() {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("All sessions revoked");
  });
}
