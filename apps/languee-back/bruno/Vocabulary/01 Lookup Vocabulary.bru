meta {
  name: Lookup Vocabulary
  type: http
  seq: 1
  tags: [
    vocabulary
    smoke
  ]
}

get {
  url: {{base_url}}/vocabulary/lookup?word={{dictionary_word}}&language={{dictionary_language}}
  body: none
  auth: inherit
}

tests {
  test("returns vocabulary with deck enrichment", function() {
    expect(res.status).to.equal(200);
    expect(res.body.lemma).to.be.a("string");
    expect(res.body.source).to.be.oneOf(["cache", "provider"]);
    expect(res.body.definitions).to.be.an("array");
    expect(res.body.definitions[0].decks).to.be.an("array");
  });
}
