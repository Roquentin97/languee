meta {
  name: Lookup Vocabulary
  type: http
  seq: 1
  tags: [
    vocabulary
    smoke
  ]
}

get {
  url: {{base_url}}/vocabulary/lookup?word={{dictionary_word}}&language={{dictionary_language}}
  body: none
  auth: inherit
}

tests {
  test("returns vocabulary with POS filtering metadata", function() {
    expect(res.status).to.equal(200);
    expect(res.body.input).to.be.a("string");
    expect(res.body.lemma).to.be.a("string");
    expect(["string", "null"]).to.include(typeof res.body.partOfSpeech);
    expect(res.body.definitions).to.be.an("array");
    expect(res.body.meta.filteredByPos).to.be.a("boolean");
    expect(res.body.meta.unmatchedPos).to.be.a("boolean");
    expect(res.body.meta.availablePartsOfSpeech).to.be.an("array");
  });
}
