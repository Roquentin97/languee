meta {
  name: Saved Matches
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/v1/vocabulary/saved-matches
  body: json
  auth: inherit
}

body:json {
  {
    "language": "en",
    "text": "The expressways connect the cities.",
    "tokens": ["the", "expressways", "connect", "cities"]
  }
}

tests {
  test("returns bounded saved vocabulary matches", function() {
    expect(res.status).to.equal(200);
    expect(res.body.matches).to.be.an("array");
  });
}
