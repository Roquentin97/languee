meta {
  name: Lookup Vocabulary German
  type: http
  seq: 7
  tags: [
    vocabulary
  ]
}

post {
  url: {{base_url}}/api/v1/vocabulary/lookup
  body: json
  auth: inherit
}

body:json {
  {
    "text": "laufe",
    "language": "de"
  }
}

tests {
  test("returns vocabulary for a German word with language echoed back", function() {
    expect(res.status).to.equal(200);
    expect(res.body.input).to.equal("laufe");
    expect(res.body.language).to.equal("de");
    expect(res.body.headwords).to.be.an("array");
    if (res.body.preferred) {
      expect(res.body.headwords.some(h => h.entryId === res.body.preferred.entryId)).to.equal(true);
    }
  });
}
