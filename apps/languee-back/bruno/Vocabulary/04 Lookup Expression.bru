meta {
  name: Lookup Expression
  type: http
  seq: 4
  tags: [
    vocabulary
  ]
}

get {
  url: {{base_url}}/api/v1/vocabulary/lookup?word={{word_phrasal_verb}}&language=en
  body: none
  auth: inherit
}

tests {
  test("returns expression-aware lookup metadata", function() {
    expect(res.status).to.equal(200);
    expect(res.body.input).to.equal("look up");
    expect(["phrasal_verb", "expression"]).to.include(res.body.kind);
    expect(res.body.headwords).to.be.an("array");
    if (res.body.preferred) {
      expect(res.body.headwords.some(h => h.wordId === res.body.preferred.wordId)).to.equal(true);
    }
    expect(res.body.meta.isExpression).to.equal(true);
    expect(res.body.meta.filteredByPos).to.equal(false);
    expect(res.body.meta.providerMiss).to.be.a("boolean");
    expect(res.body.meta.expressionContextFound).to.be.null;
  });
}
