meta {
  name: Lookup Vocabulary Spanish
  type: http
  seq: 6
  tags: [
    vocabulary
  ]
}

get {
  url: {{base_url}}/api/v1/vocabulary/lookup?word=corro&language=es
  body: none
  auth: inherit
}

tests {
  test("returns vocabulary for a Spanish word with language echoed back", function() {
    expect(res.status).to.equal(200);
    expect(res.body.input).to.equal("corro");
    expect(res.body.language).to.equal("es");
    expect(res.body.lemma).to.be.a("string");
    expect(res.body.definitions).to.be.an("array");
  });
}
