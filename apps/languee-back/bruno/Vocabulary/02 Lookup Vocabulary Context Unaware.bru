meta {
  name: Lookup Vocabulary Context Unaware
  type: http
  seq: 2
  tags: [
    vocabulary
  ]
}

get {
  url: {{base_url}}/api/v1/vocabulary/lookup?word=saw&language=en
  body: none
  auth: inherit
}

tests {
  test("returns vocabulary for saw without context", function() {
    expect(res.status).to.equal(200);
    expect(res.body.input).to.equal("saw");
    expect(res.body.context).to.be.undefined;
    expect(res.body.lemma).to.be.a("string");
    expect(res.body.definitions).to.be.an("array");
    expect(res.body.meta.filteredByPos).to.equal(false);
  });
}
