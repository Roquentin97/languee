meta {
  name: Mobile Refresh
  type: http
  seq: 3
  tags: [
    auth
    mobile
  ]
}

post {
  url: {{base_url}}/auth/mobile/refresh
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "refreshToken": "{{refreshToken}}",
    "sessionId": "{{sessionId}}"
  }
}

script:post-response {
  if (res.status === 200 && res.body?.accessToken) {
    bru.setVar("accessToken", res.body.accessToken);
    bru.setVar("refreshToken", res.body.refreshToken);
  }
}

tests {
  test("returns a new access token and refresh token", function() {
    expect(res.status).to.equal(200);
    expect(res.body.accessToken).to.be.a("string");
    expect(res.body.refreshToken).to.be.a("string");
    expect(res.body.sessionId).to.be.a("string");
  });
}
