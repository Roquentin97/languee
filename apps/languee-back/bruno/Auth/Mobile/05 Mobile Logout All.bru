meta {
  name: Mobile Logout All
  type: http
  seq: 5
  tags: [
    auth
    mobile
  ]
}

post {
  url: {{base_url}}/auth/mobile/logout-all
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("revokes all sessions", function() {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("Logged out from all sessions");
  });
}
