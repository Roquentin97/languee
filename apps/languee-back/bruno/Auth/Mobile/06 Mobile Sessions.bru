meta {
  name: Mobile Sessions
  type: http
  seq: 6
  tags: [
    auth
    mobile
  ]
}

get {
  url: {{base_url}}/auth/mobile/sessions
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

tests {
  test("returns active sessions", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}
