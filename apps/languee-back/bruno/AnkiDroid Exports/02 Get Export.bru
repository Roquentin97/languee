meta {
  name: Get Export
  type: http
  seq: 2
  tags: [
    ankidroid-exports
  ]
}

get {
  url: {{base_url}}/api/v1/ankidroid-exports/{{export_id}}
  body: none
  auth: inherit
}

tests {
  test("returns export or 404", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("returns export shape on success", function() {
    if (res.status === 200) {
      expect(res.body.id).to.be.a("string");
      expect(res.body.cardId).to.be.a("string");
      expect(res.body.status).to.be.a("string");
      expect(res.body.attempts).to.be.an("array");
    }
  });
}
