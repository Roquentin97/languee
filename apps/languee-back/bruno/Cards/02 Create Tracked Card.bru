  tags: [cards]
}

post {
  url: {{base_url}}/api/v1/cards
  body: json
  auth: inherit
}

body:json {
  {
    "deckId": "{{deck_id}}",
    "definitionId": "{{definition_id}}",
    "lookupId": "{{lookup_id}}"
  }
}

tests {
  test("validates the tracked save", function() {
    expect(res.status).to.equal(201);
  });
}
