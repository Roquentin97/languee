meta {
  name: Get Card
  type: http
  seq: 3
  tags: [
    cards
  ]
}

get {
  url: {{base_url}}/api/v1/cards/{{card_id}}
  body: none
  auth: inherit
}

vars:pre-request {
  card_id: 019ece7b-e9b5-78a5-a78a-75753bf93461
}

tests {
  test("returns card or 404", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("returns card shape on success", function() {
    if (res.status === 200) {
      expect(res.body.id).to.be.a("string");
      expect(res.body.type).to.be.oneOf(["existing", "inflection", "definition"]);
      expect(res.body.decks).to.be.an("array");
      // `definition` is null for inflection cards, an object otherwise.
      if (res.body.type !== "inflection") {
        expect(res.body.definition).to.be.an("object");
      } else {
        expect(res.body.definition).to.equal(null);
      }
    }
  });

  test("inflectionForms is null or a typed object with type discriminant", function() {
    if (res.status === 200 && res.body.definition) {
      const forms = res.body.definition.inflectionForms;
      if (forms !== null) {
        expect(forms.type).to.be.oneOf(["adjective", "verb", "noun"]);
        if (forms.type === "adjective") {
          expect(forms.positive).to.be.a("string");
        }
        if (forms.type === "verb") {
          expect(forms.base).to.be.a("string");
        }
        if (forms.type === "noun") {
          expect(forms).to.have.any.keys("singular", "plural");
        }
      }
    }
  });
}
