meta {
  name: Find Overlaps
  type: http
  seq: 3
  tags: [
    synonyms
  ]
}

get {
  url: {{base_url}}/api/v1/synonyms/overlaps
  body: none
  auth: inherit
}

params:query {
  definitionIds: {{definition_id}}
}

tests {
  test("returns overlaps array or a validation error", function() {
    expect(res.status).to.be.oneOf([200, 400]);
  });

  test("each overlap has deck info on success", function() {
    if (res.status === 200) {
      expect(res.body.overlaps).to.be.an("array");
      for (const overlap of res.body.overlaps) {
        expect(overlap.definitionId).to.be.a("string");
        expect(overlap.linkedDefinitionId).to.be.a("string");
        expect(overlap.decks).to.be.an("array");
      }
    }
  });
}
