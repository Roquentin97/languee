meta {
  name: Create Meaning Link
  type: http
  seq: 1
  tags: [
    synonyms
  ]
}

post {
  url: {{base_url}}/api/v1/synonyms
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

vars:pre-request {
  definition_id_a: 019e305d-48a9-71bc-b1ff-bc1768833a0e
  definition_id_b: 019ece7b-e9b5-78a5-a78a-75753bf93461
}

body:json {
  {
    "definitionAId": "{{definition_id_a}}",
    "definitionBId": "{{definition_id_b}}",
    "relationType": "synonym"
  }
}

tests {
  test("creates or reports an expected error", function() {
    expect(res.status).to.be.oneOf([201, 400, 404, 409]);
  });

  test("returns link shape on success", function() {
    if (res.status === 201) {
      expect(res.body.id).to.be.a("string");
      expect(res.body.relationType).to.be.a("string");
      expect(res.body.definitionA).to.be.an("object");
      expect(res.body.definitionB).to.be.an("object");
    }
  });
}
