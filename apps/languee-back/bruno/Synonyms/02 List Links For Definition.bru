meta {
  name: List Links For Definition
  type: http
  seq: 2
  tags: [
    synonyms
  ]
}

get {
  url: {{base_url}}/api/v1/synonyms/definition/{{definition_id}}
  body: none
  auth: inherit
}

tests {
  test("returns links array", function() {
    expect(res.status).to.equal(200);
    expect(res.body.links).to.be.an("array");
  });

  test("each link presents the counterpart definition as linked", function() {
    for (const link of res.body.links) {
      expect(link.id).to.be.a("string");
      expect(link.relationType).to.be.oneOf(["synonym", "related"]);
      expect(link.linked).to.be.an("object");
      expect(link.linked.definitionId).to.be.a("string");
    }
  });
}
