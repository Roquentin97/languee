meta {
  name: Post Message
  type: http
  seq: 4
  tags: [
    chat
  ]
}

post {
  url: {{base_url}}/api/v1/chat/conversations/{{conversation_id}}/messages
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

vars:pre-request {
  conversation_id: 1db3f769-e154-44c6-9b98-87de1037a395
}

body:json {
  {
    "content": "I went to the store yesterday."
  }
}

tests {
  test("posts the message or reports the conversation as not found", function() {
    expect(res.status).to.be.oneOf([201, 400, 404]);
  });

  test("returns both the user message and the bot reply", function() {
    if (res.status === 201) {
      expect(res.body.userMessage.role).to.equal("user");
      expect(res.body.assistantMessage.role).to.equal("assistant");
      expect(res.body.userMessage.content).to.be.a("string");
      expect(res.body.assistantMessage.content).to.be.a("string");
    }
  });
}
