meta {
  name: Get Suggestions
  type: http
  seq: 5
  tags: [
    chat
  ]
}

get {
  url: {{base_url}}/api/v1/chat/conversations/{{conversation_id}}/suggestions
  body: none
  auth: inherit
}

vars:pre-request {
  conversation_id: 1db3f769-e154-44c6-9b98-87de1037a395
}

tests {
  test("returns suggestions or reports the conversation as not found", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("returns the suggestions shape", function() {
    if (res.status === 200) {
      expect(res.body.suggestions).to.be.an("array");
      expect(res.body).to.have.property("analyzedAt");
      for (const suggestion of res.body.suggestions) {
        expect(suggestion.type).to.be.oneOf([
          "overused_word",
          "grammar",
          "style"
        ]);
        expect(suggestion.title).to.be.a("string");
        expect(suggestion.detail).to.be.a("string");
      }
    }
  });
}
