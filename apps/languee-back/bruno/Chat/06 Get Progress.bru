meta {
  name: Get Progress
  type: http
  seq: 6
  tags: [
    chat
  ]
}

get {
  url: {{base_url}}/api/v1/chat/progress
  body: none
  auth: inherit
}

tests {
  test("returns the progress shape", function() {
    expect(res.status).to.equal(200);
    expect(res.body.totals).to.be.an("object");
    expect(res.body.totals.suggestionsRaised).to.be.a("number");
    expect(res.body.totals.suggestionsResolved).to.be.a("number");
    expect(res.body.totals.userMessages).to.be.a("number");
    expect(res.body.totals.activeConversations).to.be.a("number");
    expect(res.body.byType).to.be.an("array");
    expect(res.body.byType).to.have.lengthOf(3);
    for (const entry of res.body.byType) {
      expect(entry.type).to.be.oneOf([
        "overused_word",
        "grammar",
        "style"
      ]);
      expect(entry.raised).to.be.a("number");
      expect(entry.resolved).to.be.a("number");
    }
    expect(res.body.weeks).to.be.an("array");
    expect(res.body).to.have.property("computedAt");
  });
}
