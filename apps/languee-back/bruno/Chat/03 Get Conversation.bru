meta {
  name: Get Conversation
  type: http
  seq: 3
  tags: [
    chat
  ]
}

get {
  url: {{base_url}}/api/v1/chat/conversations/{{conversation_id}}
  body: none
  auth: inherit
}

vars:pre-request {
  conversation_id: 1db3f769-e154-44c6-9b98-87de1037a395
}

tests {
  test("returns the conversation or reports it as not found", function() {
    expect(res.status).to.be.oneOf([200, 404]);
  });

  test("returns messages ordered oldest to newest", function() {
    if (res.status === 200) {
      expect(res.body.id).to.be.a("string");
      expect(res.body.messages).to.be.an("array");
      for (const message of res.body.messages) {
        expect(message.role).to.be.oneOf(["user", "assistant"]);
        expect(message.content).to.be.a("string");
      }
    }
  });
}
