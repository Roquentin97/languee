meta {
  name: Create Conversation
  type: http
  seq: 1
  tags: [
    chat
  ]
}

post {
  url: {{base_url}}/api/v1/chat/conversations
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

body:json {
  {
    "title": "Practicing small talk"
  }
}

tests {
  test("creates a conversation", function() {
    expect(res.status).to.equal(201);
  });

  test("returns the conversation shape", function() {
    expect(res.body.id).to.be.a("string");
    expect(res.body.title).to.equal("Practicing small talk");
    expect(res.body.messageCount).to.equal(0);
    expect(res.body).to.have.property("createdAt");
    expect(res.body).to.have.property("updatedAt");
  });
}
