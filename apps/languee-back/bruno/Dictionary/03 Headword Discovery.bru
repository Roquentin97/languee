meta {
  name: Headword Discovery
  type: http
  seq: 3
}
get {
  url: {{base_url}}/api/v1/dictionary/lookup?word=better&language=en
  body: none
  auth: inherit
}
tests {
  test("preserves the selected headword identity", function() {
    expect(res.status).to.equal(200);
    expect(res.body.lemma).to.be.a("string");
    expect(res.body.definitions).to.be.an("array");
  });
}
