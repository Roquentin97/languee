meta {
  name: Create Checkout Session
  type: http
  seq: 3
  tags: [
    billing
  ]
}

post {
  url: {{base_url}}/api/v1/billing/checkout-session
  body: json
  auth: inherit
}

headers {
  content-type: application/json
}

body:json {
  {
    "tier": "plus"
  }
}

tests {
  test("returns a checkout session url or reports billing is not configured", function() {
    expect(res.status).to.be.oneOf([201, 503]);
    if (res.status === 201) {
      expect(res.body.url).to.be.a("string");
      expect(res.body.sessionId).to.be.a("string");
    } else {
      expect(res.body.error).to.equal("BILLING_NOT_CONFIGURED");
    }
  });
}
