meta {
  name: Get Plans
  type: http
  seq: 1
  tags: [
    billing
  ]
}

get {
  url: {{base_url}}/api/v1/billing/plans
  body: none
  auth: inherit
}

tests {
  test("returns the plan table with a billingConfigured flag", function() {
    expect(res.status).to.equal(200);
    expect(res.body.plans).to.be.an("array");
    expect(res.body.plans.map(p => p.tier)).to.eql(["free", "plus", "pro"]);
    expect(res.body.billingConfigured).to.be.a("boolean");
  });
}
