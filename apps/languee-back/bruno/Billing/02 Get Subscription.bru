meta {
  name: Get Subscription
  type: http
  seq: 2
  tags: [
    billing
  ]
}

get {
  url: {{base_url}}/api/v1/billing/subscription
  body: none
  auth: inherit
}

tests {
  test("returns the current subscription state (free/active by default)", function() {
    expect(res.status).to.equal(200);
    expect(res.body.tier).to.be.oneOf(["free", "plus", "pro"]);
    expect(res.body.status).to.be.oneOf([
      "active",
      "trialing",
      "past_due",
      "canceled",
      "incomplete"
    ]);
    expect(res.body.billingConfigured).to.be.a("boolean");
  });
}
