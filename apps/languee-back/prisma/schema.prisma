generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  decks        Deck[]
  cards        Card[]

  @@map("users")
}

model Word {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  lemma       String
  language    String       @default("en")
  ipa         String?
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  definitions Definition[]

  @@unique([lemma, language])
  @@index([lemma, language])
  @@map("words")
}

model Definition {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  wordId             String   @map("word_id") @db.Uuid
  word               Word     @relation(fields: [wordId], references: [id])
  partOfSpeech       String   @map("part_of_speech")
  definition         String
  example            String?
  provider           String
  gapFillMetadata    Json?    @map("gap_fill_metadata") @db.JsonB
  hasIrregularForms  Boolean  @default(false) @map("has_irregular_forms")
  inflectionForms    Json?    @map("inflection_forms") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  cards              Card[]

  @@unique([wordId, partOfSpeech, definition])
  @@index([wordId])
  @@index([partOfSpeech])
  @@index([partOfSpeech, hasIrregularForms])
  @@map("definitions")
}

model Deck {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  name      String
  language  String
  cards     Card[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, name])
  @@map("decks")
}

model Card {
  id           String     @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deckId       String     @map("deck_id") @db.Uuid
  deck         Deck       @relation(fields: [deckId], references: [id])
  userId       String     @map("user_id") @db.Uuid
  user         User       @relation(fields: [userId], references: [id])
  definitionId String     @map("definition_id") @db.Uuid
  definition   Definition @relation(fields: [definitionId], references: [id])
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([deckId, definitionId])
  @@map("cards")
}
