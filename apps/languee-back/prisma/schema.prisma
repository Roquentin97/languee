generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  email            String            @unique
  passwordHash     String            @map("password_hash")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  decks            Deck[]
  cards            Card[]
  chatConversations ChatConversation[]
  chatProgressStats ChatProgressStat[]
  subscription      Subscription?

  @@map("users")
}

enum LexicalKind {
  word
  phrasal_verb
  expression
}

model Word {
  id          String       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  lemma       String
  language    String       @default("en")
  ipa         String?
  kind        LexicalKind  @default(word)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  definitions Definition[]

  @@unique([lemma, language])
  @@index([lemma, language])
  @@map("words")
}

model Definition {
  id                 String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  wordId             String   @map("word_id") @db.Uuid
  word               Word     @relation(fields: [wordId], references: [id])
  partOfSpeech       String   @map("part_of_speech")
  definition         String
  example            String?
  provider           String
  gapFillMetadata    Json?    @map("gap_fill_metadata") @db.JsonB
  hasIrregularForms  Boolean  @default(false) @map("has_irregular_forms")
  inflectionForms    Json?    @map("inflection_forms") @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  cards              Card[]
  meaningLinksA      MeaningLink[] @relation("MeaningLinkDefinitionA")
  meaningLinksB      MeaningLink[] @relation("MeaningLinkDefinitionB")

  @@unique([wordId, partOfSpeech, definition])
  @@index([wordId])
  @@index([partOfSpeech])
  @@index([partOfSpeech, hasIrregularForms])
  @@map("definitions")
}

model Deck {
  id        String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id])
  name      String
  cards     Card[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([userId, name])
  @@map("decks")
}

model Card {
  id              String                  @id @default(dbgenerated("uuidv7()")) @db.Uuid
  deckId          String                  @map("deck_id") @db.Uuid
  deck            Deck                    @relation(fields: [deckId], references: [id])
  userId          String                  @map("user_id") @db.Uuid
  user            User                    @relation(fields: [userId], references: [id])
  definitionId    String                  @map("definition_id") @db.Uuid
  definition      Definition              @relation(fields: [definitionId], references: [id])
  context         String?
  inflectionForms Json?                   @map("inflection_forms") @db.JsonB
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz
  ankidroidExport CardAnkiDroidExport?
  reviewState     CardReviewState?
  reviewLogs      ReviewLog[]

  @@unique([deckId, definitionId])
  @@map("cards")
}

enum CardAnkiDroidExportStatus {
  pending
  completed
  failed
}

model CardAnkiDroidExport {
  id                     String                       @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cardId                 String                       @unique @map("card_id") @db.Uuid
  card                   Card                         @relation(fields: [cardId], references: [id])
  status                 CardAnkiDroidExportStatus    @default(pending)
  failureReason          String?                      @map("failure_reason")
  failureMessage         String?                      @map("failure_message")
  ankiNoteId             String?                      @map("anki_note_id")
  ankiDeckId             String?                      @map("anki_deck_id")
  ankiDeckNameSnapshot   String?                      @map("anki_deck_name_snapshot")
  ankiModelId            String?                      @map("anki_model_id")
  ankiModelNameSnapshot  String?                      @map("anki_model_name_snapshot")
  templateVersion        String?                      @map("template_version")
  lastAttemptedAt        DateTime?                    @map("last_attempted_at") @db.Timestamptz
  completedAt            DateTime?                    @map("completed_at") @db.Timestamptz
  attempts               CardAnkiDroidExportAttempt[]
  createdAt              DateTime                     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime                     @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([cardId])
  @@map("card_ankidroid_exports")
}

model CardAnkiDroidExportAttempt {
  id             String                    @id @default(dbgenerated("uuidv7()")) @db.Uuid
  exportId       String                    @map("export_id") @db.Uuid
  export         CardAnkiDroidExport       @relation(fields: [exportId], references: [id])
  status         CardAnkiDroidExportStatus
  failureReason  String?                   @map("failure_reason")
  failureMessage String?                   @map("failure_message")
  attemptedAt    DateTime                  @default(now()) @map("attempted_at") @db.Timestamptz

  @@index([exportId])
  @@map("card_ankidroid_export_attempts")
}

enum MeaningLinkType {
  synonym
  related
}

enum MeaningLinkSource {
  user
  provider
}

model MeaningLink {
  id             String            @id @default(dbgenerated("uuidv7()")) @db.Uuid
  definitionAId  String            @map("definition_a_id") @db.Uuid
  definitionA    Definition        @relation("MeaningLinkDefinitionA", fields: [definitionAId], references: [id])
  definitionBId  String            @map("definition_b_id") @db.Uuid
  definitionB    Definition        @relation("MeaningLinkDefinitionB", fields: [definitionBId], references: [id])
  relationType   MeaningLinkType   @map("relation_type")
  source         MeaningLinkSource @default(user)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@unique([definitionAId, definitionBId, relationType])
  @@index([definitionAId])
  @@index([definitionBId])
  @@map("meaning_links")
}

enum ReviewCardState {
  new
  learning
  review
}

enum ReviewRating {
  again
  hard
  good
  easy
}

enum ReviewAnswerResult {
  correct
  close_synonym
  incorrect
  revealed
}

model CardReviewState {
  id             String          @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cardId         String          @unique @map("card_id") @db.Uuid
  card           Card            @relation(fields: [cardId], references: [id])
  state          ReviewCardState @default(new)
  dueAt          DateTime        @default(now()) @map("due_at") @db.Timestamptz
  intervalDays   Float           @default(0) @map("interval_days")
  easeFactor     Float           @default(2.5) @map("ease_factor")
  repetitions    Int             @default(0)
  lapses         Int             @default(0)
  lastReviewedAt DateTime?       @map("last_reviewed_at") @db.Timestamptz
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  @@index([dueAt])
  @@map("card_review_states")
}

model ReviewLog {
  id                   String              @id @default(dbgenerated("uuidv7()")) @db.Uuid
  cardId               String              @map("card_id") @db.Uuid
  card                 Card                @relation(fields: [cardId], references: [id])
  rating               ReviewRating
  typedAnswer          String?             @map("typed_answer")
  answerResult         ReviewAnswerResult? @map("answer_result")
  previousIntervalDays Float               @map("previous_interval_days")
  newIntervalDays      Float               @map("new_interval_days")
  easeFactorAfter      Float               @map("ease_factor_after")
  dueAtAfter           DateTime            @map("due_at_after") @db.Timestamptz
  reviewedAt           DateTime            @default(now()) @map("reviewed_at") @db.Timestamptz

  @@index([cardId, reviewedAt])
  @@map("review_logs")
}

enum ChatMessageRole {
  user
  assistant
}

enum ChatSuggestionType {
  overused_word
  grammar
  style
}

model ChatConversation {
  id                String                 @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  user              User                   @relation(fields: [userId], references: [id])
  title             String?
  analyzedAt        DateTime?              @map("analyzed_at") @db.Timestamptz
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz
  messages          ChatMessage[]
  suggestions       ChatSuggestion[]
  analysisSnapshots ChatAnalysisSnapshot[]

  @@index([userId])
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String           @map("conversation_id") @db.Uuid
  conversation   ChatConversation @relation(fields: [conversationId], references: [id])
  role           ChatMessageRole
  content        String
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

model ChatSuggestion {
  id             String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId String             @map("conversation_id") @db.Uuid
  conversation   ChatConversation   @relation(fields: [conversationId], references: [id])
  type           ChatSuggestionType
  title          String
  detail         String
  payload        Json?              @db.JsonB
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId])
  @@map("chat_suggestions")
}

model ChatAnalysisSnapshot {
  id               String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  conversationId   String           @map("conversation_id") @db.Uuid
  conversation     ChatConversation @relation(fields: [conversationId], references: [id])
  userMessageCount Int              @map("user_message_count")
  fingerprints     Json             @db.JsonB
  countsByType     Json             @map("counts_by_type") @db.JsonB
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@index([conversationId, createdAt])
  @@map("chat_analysis_snapshots")
}

model ChatProgressStat {
  id             String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id])
  weekStart      DateTime @map("week_start") @db.Date
  raised         Int
  resolved       Int
  resolvedByType Json     @map("resolved_by_type") @db.JsonB
  raisedByType   Json     @map("raised_by_type") @db.JsonB
  userMessages   Int      @map("user_messages")
  computedAt     DateTime @map("computed_at") @db.Timestamptz

  @@unique([userId, weekStart])
  @@map("chat_progress_stats")
}

enum SubscriptionTier {
  free
  plus
  pro
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
}

model Subscription {
  id                   String             @id @default(dbgenerated("uuidv7()")) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  user                 User               @relation(fields: [userId], references: [id])
  tier                 SubscriptionTier   @default(free)
  status               SubscriptionStatus @default(active)
  stripeCustomerId     String?            @unique @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  currentPeriodEnd     DateTime?          @map("current_period_end") @db.Timestamptz
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  @@map("subscriptions")
}

model BillingEvent {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  stripeEventId String   @unique @map("stripe_event_id")
  type          String
  payload       Json     @db.JsonB
  processedAt   DateTime @default(now()) @map("processed_at") @db.Timestamptz

  @@index([type])
  @@map("billing_events")
}
