meta {
  name: Inflections
  type: http
  seq: 2
}
get {
  url: {{base_url}}/morphology/inflections?text=be&partOfSpeech=verb&language=en
  body: none
  auth: inherit
}
tests {
  test("preserves variant spellings", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.deep.include({ form: "was", formType: "past" });
    expect(res.body).to.deep.include({ form: "were", formType: "past" });
  });
}
