meta {
  name: Analyze Word
  type: http
  seq: 1
  tags: [
    words
    smoke
  ]
}

get {
  url: {{base_url}}/words?word={{word}}
  body: none
  auth: inherit
}

tests {
  test("returns token analysis", function() {
    expect(res.status).to.equal(200);
    expect(res.body.input_text).to.be.a("string");
    expect(res.body.is_multi_word).to.equal(false);
    expect(res.body.tokens).to.be.an("array").with.length(1);
    expect(res.body.tokens[0].lemma).to.be.a("string");
    expect(res.body.tokens[0].pos).to.be.a("string");
  });
}
