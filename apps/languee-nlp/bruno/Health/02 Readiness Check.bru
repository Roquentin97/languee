meta {
  name: Readiness Check
  type: http
  seq: 2
  tags: [
    health
    smoke
  ]
}

get {
  url: {{base_url}}/ready
  body: none
  auth: none
}

tests {
  test("returns model readiness", function() {
    expect(res.status).to.equal(200);
    expect(res.body.model).to.be.a("string");
    expect(res.body.vocab_size).to.be.a("number");
    expect(res.body.lang).to.be.a("string");
  });
}
