meta {
  name: 05 Selected Occurrence
  type: http
  seq: 20
}

get {
  url: {{base_url}}/analyze?text=saw&input_text=I%20saw%20the%20saw.&selection_start=10&selection_end=13
  body: none
  auth: inherit
}

tests {
  test("expected status", function() {
    expect(res.status).to.equal(200);
    expect(res.body.model_version).to.be.a("string");
    expect(res.body.tokens[0].lemma).to.be.a("string");
    expect(res.body.tokens[0].pos).to.be.a("string");
  });
}
