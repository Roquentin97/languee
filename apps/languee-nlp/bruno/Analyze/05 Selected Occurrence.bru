meta {
  name: 05 Selected Occurrence
  type: http
  seq: 20
}

post {
  url: {{base_url}}/analyze
  body: json
  auth: inherit
}
body:json {
  {
    "text": "saw",
    "input_text": "I saw the saw.",
    "selection_ranges": [{ "start": 10, "end": 13 }]
  }
}

tests {
  test("expected status", function() {
    expect(res.status).to.equal(200);
    expect(res.body.model_version).to.be.a("string");
    expect(res.body.tokens[0].lemma).to.be.a("string");
    expect(res.body.tokens[0].pos).to.be.a("string");
    expect(res.body.selection_analysis).to.equal(null);
  });
}
