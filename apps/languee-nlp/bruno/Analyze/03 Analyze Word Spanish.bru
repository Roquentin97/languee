meta {
  name: Analyze Word Spanish
  type: http
  seq: 3
  tags: [
    analyze
    spanish
  ]
}

get {
  url: {{base_url}}/analyze?text=hablo&language=es
  body: none
  auth: inherit
}

tests {
  test("returns word analysis for Spanish word", function() {
    expect(res.status).to.equal(200);
    expect(res.body.kind).to.equal("word");
    expect(res.body.language).to.equal("es");
    expect(res.body.tokens).to.be.an("array").with.length(1);
    expect(res.body.tokens[0].lemma).to.be.a("string");
    expect(res.body.tokens[0].extra_forms).to.be.an("object");
  });
}
