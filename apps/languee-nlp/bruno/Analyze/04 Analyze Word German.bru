meta {
  name: Analyze Word German
  type: http
  seq: 4
  tags: [
    analyze
    german
  ]
}

get {
  url: {{base_url}}/analyze?text=mache&language=de
  body: none
  auth: inherit
}

tests {
  test("returns word analysis for German word", function() {
    expect(res.status).to.equal(200);
    expect(res.body.kind).to.equal("word");
    expect(res.body.language).to.equal("de");
    expect(res.body.tokens).to.be.an("array").with.length(1);
    expect(res.body.tokens[0].lemma).to.be.a("string");
    expect(res.body.tokens[0].extra_forms).to.be.an("object");
  });
}
