meta {
  name: Analyze Expression Context-Aware
  type: http
  seq: 4
  tags: [
    analyze
    input_text
  ]
}

post {
  url: {{base_url}}/analyze
  body: json
  auth: inherit
}
body:json {
  {
    "text": "gave up",
    "input_text": "He gave it all up yesterday.",
    "selection_ranges": [
      { "start": 3, "end": 7 },
      { "start": 15, "end": 17 }
    ]
  }
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("context_match is present", function() {
    expect(res.body.context_match).to.be.an("object");
    expect(res.body.context_match.found).to.equal(true);
    expect(res.body.selection_analysis.pos).to.equal("VERB");
    expect(res.body.model_version).to.be.a("string");
  });
}
