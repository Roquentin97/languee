# languee-nlp runtime env. Copy to /opt/languee/nlp.env on the server (chmod 600).

LANGUEE_NLP_SPACY_MODEL=en_core_web_md

# Must match LANGUEE_NLP_BASIC_AUTH_LOGIN/PASSWORD in api.env
BASIC_LOGIN=admin
BASIC_PASSWORD=changeme

# Logging
LANGUEE_NLP_LOG_FORMAT=json
LANGUEE_NLP_LOG_LEVEL=info
LANGUEE_NLP_SERVICE_NAME=languee-nlp
LANGUEE_NLP_ENVIRONMENT=production

# Tracing — off until an OTLP endpoint (Grafana Cloud) is configured; the
# service's exporter points at the endpoint below when enabled.
LANGUEE_NLP_TRACING_ENABLED=false
# LANGUEE_NLP_OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
