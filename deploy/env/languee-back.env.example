# REFERENCE ONLY. /opt/languee/languee-back.env is generated by
# deploy/scripts/sync-vault-config.py from the OCI Vault secret on every deploy
# (see deploy/VAULT.md); edits on the server are overwritten. The comments below
# document what each key means.
#
# DATABASE_URL and REDIS_PASSWORD are deliberately absent: docker-compose.prod.yml
# derives them from the LANGUEE_BACK_POSTGRES_*/LANGUEE_BACK_REDIS_PASSWORD
# values in .env, so those credentials are declared exactly once.

# App
PORT=3000
NODE_ENV=production

# Redis client
REDIS_HOST=redis
REDIS_PORT=6379

# Auth
JWT_SECRET=replace-with-at-least-16-characters
JWT_EXPIRES_IN=15m

# Swagger Basic Auth
BASIC_AUTH=admin
BASIC_PASSWORD=changeme

# NLP Service — credentials must match BASIC_LOGIN/BASIC_PASSWORD in languee-nlp.env
LANGUEE_NLP_BASE_URL=http://languee-nlp:8000
LANGUEE_NLP_BASIC_AUTH_LOGIN=admin
LANGUEE_NLP_BASIC_AUTH_PASSWORD=changeme

# Logging
LOG_FORMAT=json
SERVICE_NAME=languee-back
PRINT_DEBUG_LOGS=false
PRINT_PRETTY_JSON_LOGS=false

# Tracing (OpenTelemetry) is sent only to the private Alloy receiver.
TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
