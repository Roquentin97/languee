# REFERENCE ONLY. /opt/languee/languee-nlp.env is generated by
# deploy/scripts/sync-vault-config.py from the OCI Vault secret on every deploy
# (see deploy/VAULT.md); edits on the server are overwritten. The comments below
# document what each key means.

LANGUEE_NLP_SPACY_MODEL=en_core_web_md

# Not separate keys in Vault: generated from LANGUEE_NLP_BASIC_AUTH_LOGIN/PASSWORD,
# which the same deploy also writes to languee-back.env.
BASIC_LOGIN=admin
BASIC_PASSWORD=changeme

# Logging
LANGUEE_NLP_LOG_FORMAT=json
LANGUEE_NLP_LOG_LEVEL=info
LANGUEE_NLP_SERVICE_NAME=languee-nlp
LANGUEE_NLP_ENVIRONMENT=production

# Tracing is sent only to the private Alloy receiver.
LANGUEE_NLP_TRACING_ENABLED=true
LANGUEE_NLP_OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
