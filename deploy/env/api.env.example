# languee-back runtime env. Copy to /opt/languee/api.env on the server (chmod 600).
# Hostnames refer to compose service names on the internal network.

# App
PORT=3000
NODE_ENV=production

# Database — credentials must match LANGUEE_BACK_POSTGRES_* in /opt/languee/.env
DATABASE_URL=postgresql://languee:changeme@postgres:5432/languee

# Redis client — password must match LANGUEE_BACK_REDIS_PASSWORD in /opt/languee/.env
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# Auth
JWT_SECRET=replace-with-at-least-16-characters
JWT_EXPIRES_IN=15m

# Swagger Basic Auth
BASIC_AUTH=admin
BASIC_PASSWORD=changeme

# NLP Service — credentials must match BASIC_LOGIN/BASIC_PASSWORD in nlp.env
LANGUEE_NLP_BASE_URL=http://nlp:8000
LANGUEE_NLP_BASIC_AUTH_LOGIN=admin
LANGUEE_NLP_BASIC_AUTH_PASSWORD=changeme

# Logging
LOG_FORMAT=json
SERVICE_NAME=languee-back
PRINT_DEBUG_LOGS=false
PRINT_PRETTY_JSON_LOGS=false

# Tracing (OpenTelemetry) — off until a Grafana Cloud stack is configured.
# To enable, set TRACING_ENABLED=true and fill in the Grafana Cloud OTLP
# gateway + basic-auth token (instance id:token, base64) per deploy/README.md.
TRACING_ENABLED=false
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of instanceId:token>
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1.0
