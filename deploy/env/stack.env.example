# Compose-level configuration. Copy to /opt/languee/.env on the server.
# Values here are read by docker compose for interpolation and by
# scripts/backup-db.sh. Keep the file chmod 600.

# Lets plain `docker compose ...` work from /opt/languee without -f flags.
COMPOSE_FILE=docker-compose.prod.yml

# Image tag to run. The deploy workflow pins this per deploy; `latest` is the
# fallback for a manual first start.
TAG=latest

# Public hostname languee-back is served on (Caddy issues TLS for it).
DOMAIN=api.example.com

# Postgres bootstrap credentials. These are the single source of truth:
# docker-compose.prod.yml builds languee-back's DATABASE_URL from them, so
# languee-back.env does not restate it. Because the password is interpolated
# into a URL, keep it URL-safe (letters, digits, `-`, `_`, `.`, `~`) — anything
# needing percent-encoding will break DATABASE_URL parsing.
LANGUEE_BACK_POSTGRES_USER=languee
LANGUEE_BACK_POSTGRES_PASSWORD=changeme
LANGUEE_BACK_POSTGRES_DB=languee

# Redis auth. Also the single source of truth — compose passes it to
# languee-back as REDIS_PASSWORD.
LANGUEE_BACK_REDIS_PASSWORD=changeme

# --- Backups (scripts/backup-db.sh) -----------------------------------------
# rclone remote:bucket to copy nightly dumps to (see deploy/README.md for
# Cloudflare R2 rclone setup).
BACKUP_RCLONE_REMOTE=r2:languee-db-backups
# Days of local + remote retention.
BACKUP_RETENTION_DAYS=90
# Optional healthchecks.io ping URL; leave empty to skip the heartbeat.
BACKUP_HEALTHCHECK_URL=
