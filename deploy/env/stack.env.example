# REFERENCE ONLY. /opt/languee/.env is generated by
# deploy/scripts/sync-vault-config.py from the OCI Vault secret on every deploy
# (see deploy/VAULT.md); edits on the server are overwritten. COMPOSE_FILE and
# LANGUEE_BACK_TAG and LANGUEE_NLP_TAG are written by the deploy state, not
# stored in Vault. The comments below
# document what each key means.

# Lets plain `docker compose ...` work from /opt/languee without -f flags.
COMPOSE_FILE=docker-compose.prod.yml

# Image tags to run. The migrator uses LANGUEE_BACK_TAG.
LANGUEE_BACK_TAG=sha-back1234567
LANGUEE_NLP_TAG=sha-nlp1234567

# Public hostname languee-back is served on (Caddy issues TLS for it).
DOMAIN=api.example.com
# Grafana and Android OTLP have separate public hostnames.
MONITOR_DOMAIN=monitor.example.com
TELEMETRY_DOMAIN=telemetry.example.com

# Grafana built-in bootstrap account; anonymous access is disabled.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-at-least-16-characters

# Caddy checks this bcrypt hash for Android OTLP ingestion. Generate it with
# `caddy hash-password`; TELEMETRY_PASSWORD never belongs on the server.
TELEMETRY_USERNAME=android-ingest
TELEMETRY_PASSWORD_HASH='$2a$14$zZ/fK0O1v25TxX9zoK8fmOAKjJpk8Eb.OXDC8Fj9fQcs6l9zkPy.e'

# Postgres bootstrap credentials. These are the single source of truth:
# docker-compose.prod.yml builds languee-back's DATABASE_URL from them, so
# languee-back.env does not restate it. Because the password is interpolated
# into a URL, keep it URL-safe (letters, digits, `-`, `_`, `.`, `~`) — anything
# needing percent-encoding will break DATABASE_URL parsing.
LANGUEE_BACK_POSTGRES_USER=languee
LANGUEE_BACK_POSTGRES_PASSWORD=changeme
LANGUEE_BACK_POSTGRES_DB=languee

# Redis auth. Also the single source of truth — compose passes it to
# languee-back as REDIS_PASSWORD.
LANGUEE_BACK_REDIS_PASSWORD=changeme

# --- Backups (scripts/backup-db.sh) -----------------------------------------
# rclone remote:bucket to copy nightly dumps to (see deploy/README.md for
# Cloudflare R2 rclone setup).
BACKUP_RCLONE_REMOTE=r2:languee-db-backups
# Days of local + remote retention.
BACKUP_RETENTION_DAYS=90
# Optional healthchecks.io ping URL; leave empty to skip the heartbeat.
BACKUP_HEALTHCHECK_URL=
