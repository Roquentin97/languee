{
  "uid": "languee-red",
  "title": "Languee — RED Metrics",
  "description": "Request rate, error rate, and duration per service. Powered by OTel auto-instrumentation → Alloy → Prometheus. Exemplar dots on latency panels link directly to traces in Tempo.",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "tags": ["languee", "red", "opentelemetry"],
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(http_server_duration_milliseconds_count, service_name)",
        "query": {
          "query": "label_values(http_server_duration_milliseconds_count, service_name)",
          "refId": "StandardVariableQuery"
        },
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "options": [],
        "hide": 0,
        "sort": 1
      }
    ]
  },
  "annotations": { "list": [] },
  "links": [
    {
      "title": "Explore Traces in Tempo",
      "type": "link",
      "url": "/explore?orgId=1&left=%7B%22datasource%22%3A%22tempo%22%7D",
      "icon": "external link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "id": 1,
      "title": "Request Rate (req/s)",
      "description": "HTTP server requests per second, grouped by service.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service_name) (rate(http_server_duration_milliseconds_count{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Error Rate (%)",
      "description": "Percentage of HTTP 5xx responses, grouped by service.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "100 * sum by (service_name) (rate(http_server_duration_milliseconds_count{service_name=~\"$service\",http_status_code=~\"5..\"}[$__rate_interval])) / sum by (service_name) (rate(http_server_duration_milliseconds_count{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}}",
          "refId": "A",
          "exemplar": true
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Latency — P50 / P95 / P99",
      "description": "HTTP request duration percentiles by service. P95 exemplars link to representative traces in Tempo.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le, service_name) (rate(http_server_duration_milliseconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50 {{service_name}}",
          "refId": "A",
          "exemplar": false
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(http_server_duration_milliseconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p95 {{service_name}}",
          "refId": "B",
          "exemplar": true
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le, service_name) (rate(http_server_duration_milliseconds_bucket{service_name=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99 {{service_name}}",
          "refId": "C",
          "exemplar": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5, "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Requests by Route",
      "description": "Request rate broken down by HTTP route, showing traffic distribution per service.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service_name, http_target) (rate(http_server_duration_milliseconds_count{service_name=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{service_name}} {{http_target}}",
          "refId": "A",
          "exemplar": false
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "right" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 5, "spanNulls": false }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Active HTTP Connections",
      "description": "In-flight HTTP server requests per service at any given moment.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (service_name) (http_server_active_requests{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 1, "fillOpacity": 10, "spanNulls": false }
        },
        "overrides": []
      }
    }
  ]
}
