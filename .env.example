# Notion
NOTION_SPEC_DB_ID=
GITHUB_PAT=

# Pipeline behaviour
FORGE_DRY_RUN=false

# Languee Back - local Compose infrastructure
LANGUEE_BACK_API_PORT=3000
LANGUEE_BACK_POSTGRES_PORT=5432
LANGUEE_BACK_POSTGRES_USER=user
LANGUEE_BACK_POSTGRES_PASSWORD=changeme
LANGUEE_BACK_POSTGRES_DB=languee
LANGUEE_BACK_REDIS_PASSWORD=changeme

# Languee NLP
LANGUEE_NLP_PORT=8000
LANGUEE_NLP_SPACY_MODEL=en_core_web_md
BASIC_LOGIN=admin
BASIC_PASSWORD=changeme

# Logging
# LANGUEE_NLP_LOG_FORMAT=json
# LANGUEE_NLP_LOG_LEVEL=info
# LANGUEE_NLP_SERVICE_NAME=languee-nlp
# LANGUEE_NLP_ENVIRONMENT=development

# Tracing (OpenTelemetry) - shared toggle, applies to all services via TRACING_ENABLED
TRACING_ENABLED=true
# LANGUEE_NLP_OTEL_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
